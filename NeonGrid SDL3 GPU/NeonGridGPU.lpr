program NeonGridGPU;

{ Neon Dot Grid (SDL3 GPU) - animated UI background rendered by shaders.

    uGPUView.pas    SDL3 GPU device: 2 shader passes + blit, VSync present
    uGPUShaders.pas DXIL/DXBC bytecode generated by build_shaders.ps1 from
                    shaders\*.hlsl (fullscreen_vs, dots_ps, composite_ps)
    uRenderer.pas   colour model + BGRABitmap dot sprite (uploaded to the GPU),
                    previews and the CPU renderer used for GIF/MP4 exports
    uParams.pas     every parameter (registry used by the settings UI and presets)
    uInfoForm.pas   separate LCL window: overview, performance, parameters,
                    layers, graphics and export (PNG / GIF / MP4)
    uExport.pas     PNG + animated GIF helpers (TBGRAAnimatedGif)
    uMFVideo.pas    H.264 MP4 writer (Windows Media Foundation)

  The SDL window and the LCL info window share the main thread: the SDL frame
  is rendered from the LCL idle loop. Close the SDL window to quit.
  Keys in the SDL window: F1 info window, F11 fullscreen, Esc leave
  fullscreen, Space pause. Needs SDL3.dll next to the program and Direct3D 12.
  Command line: --noinfo (start with the info window hidden), --fullscreen,
  --novsync (uncapped frame rate),
  --tab=N (info window tab: 0 Overview, 1 Performance, 2 Parameters,
  3 Layers, 4 Graphics, 5 Export),
  --bench=SECONDS (measure frame pacing, write NeonGridGPU-bench.txt, quit). }

{$mode objfpc}{$H+}

uses
  {$IFDEF UNIX}cthreads,{$ENDIF}
  Interfaces, Forms, SysUtils, uParams, uRenderer, uExport, uMFVideo, uGPUShaders, uGPUView, uInfoForm;

{$R *.res}

begin
  RequireDerivedFormResource := False;  // forms are built in code
  Application.Title := 'Neon Dot Grid SDL3 GPU';
  Application.Scaled := True;
  Application.Initialize;
  try
    View := TGPUView.Create;
  except
    on E: Exception do
    begin
      Application.MessageBox(PChar(E.Message), 'Neon Dot Grid SDL3 GPU', 0);
      Exit;
    end;
  end;
  Application.ShowMainForm := not Application.HasOption('noinfo');  // --noinfo: start hidden (F1 shows it)
  Application.CreateForm(TInfoForm, InfoForm);
  if Application.HasOption('tab') then  // --tab=N: open the info window on tab N (0 = Overview)
    InfoForm.SelectTab(StrToIntDef(Application.GetOptionValue('tab'), 1));
  if Application.HasOption('fullscreen') then View.ToggleFullScreen;
  if Application.HasOption('novsync') then P.VSync := False;  // --novsync: uncapped frame rate
  Application.Run;
  if Assigned(InfoForm) then InfoForm.StopAsync;  // no preview thread may outlive the renderer
  FreeAndNil(View);
end.
