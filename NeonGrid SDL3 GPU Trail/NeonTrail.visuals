;@category Popups

[Popups]
;@float|0|6|1.4|Upward speed of the floating score texts in cells per second.
Rise=1.4
;@float|0.2|5|1.2|Seconds a popup stays.
Life=1.2
;@float|0|5|0.6|Age in seconds when the popup starts to fade.
Fade start=0.6
;@float|0.05|5|0.6|Seconds of the fade out.
Fade time=0.6
;@float|0|1|0.5|How much the bead colour of a popup is mixed with white.
White mix=0.5
;@int|0|2|2|Popup text size: 0 small, 1 middle, 2 big.
Font=2

[Particles]
;@float|-10|20|3|Downward pull on sparks in cells per second squared.
Gravity=3
;@float|0|10|2.2|Air drag of sparks (higher = they stop sooner).
Drag=2.2
