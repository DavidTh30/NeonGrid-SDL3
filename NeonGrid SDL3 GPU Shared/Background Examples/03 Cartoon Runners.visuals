; Background example "Cartoon Runners" for Neon Beads and Neon Trail.
; Colour show 3: a chomping runner chased by a ghost across the screen.
; Apply it with NeonVisualEditor (Example > Apply example): it sets the Background
; values of the chosen game (defaults + the values of this example); then tune and
; save as usual. Same format as the .visuals files.

;@category Background

[Rendering]
;@float|0|4|1|Animation speed multiplier.
Time scale=1
;@bool|0|1|0|Freeze animation time (rendering continues).
Paused=0
;@float|0.2|3|1|Global brightness gain applied in the final pass.
Exposure=1

[Grid]
;@int|4|80|21|Dots across the shorter window side; cell size = min(width, height) / columns.
Columns=21
;@float|0.3|0.75|0.5|Circle radius as a fraction of the cell (0.5 = neighbours touch and leave black diamonds).
Dot radius=0.5
;@float|-3|3|0|Grid scroll speed in cells per second (horizontal).
Scroll X=0
;@float|-3|3|0|Grid scroll speed in cells per second (vertical).
Scroll Y=0

[Background]
;@color|0|0|#000000|Base colour behind all dots (the diamond gaps).
Color=#000000

[Color field]
;@color|0|0|#0C1C3E|Colour used where no blob has influence.
Ambient color=#0C1C3E
;@float|0|1|0.08|Weight of the ambient colour in the blob average.
Ambient weight=0.08
;@float|0|2|1|Brightness multiplier of the colour field.
Brightness=1
;@float|0|2|1.15|Saturation multiplier of the colour field.
Saturation=1.15

[Blob 1]
;@bool|0|1|1|Include this gaussian colour source.
Enabled=1
;@float|-0.5|1.5|0.06|Horizontal centre (0 = left, 1 = right).
X=0.06
;@float|-0.5|1.5|0.42|Vertical centre (0 = top, 1 = bottom).
Y=0.42
;@float|0.02|1|0.24|Gaussian radius in window-height units.
Radius=0.24
;@float|0|3|1.4|Relative influence in the weighted colour average.
Weight=1.4
;@float|0|0.3|0.04|How far the blob wanders (Lissajous drift).
Drift amp=0.04
;@float|0|2|0.11|Drift speed in radians per second.
Drift speed=0.11
;@color|0|0|#CE7C2C|Blob colour.
Color=#CE7C2C

[Blob 2]
;@bool|0|1|1|Include this gaussian colour source.
Enabled=1
;@float|-0.5|1.5|0.16|Horizontal centre (0 = left, 1 = right).
X=0.16
;@float|-0.5|1.5|0.66|Vertical centre (0 = top, 1 = bottom).
Y=0.66
;@float|0.02|1|0.13|Gaussian radius in window-height units.
Radius=0.13
;@float|0|3|0.9|Relative influence in the weighted colour average.
Weight=0.9
;@float|0|0.3|0.05|How far the blob wanders (Lissajous drift).
Drift amp=0.05
;@float|0|2|0.17|Drift speed in radians per second.
Drift speed=0.17
;@color|0|0|#D6983E|Blob colour.
Color=#D6983E

[Blob 3]
;@bool|0|1|1|Include this gaussian colour source.
Enabled=1
;@float|-0.5|1.5|0.1|Horizontal centre (0 = left, 1 = right).
X=0.1
;@float|-0.5|1.5|0.84|Vertical centre (0 = top, 1 = bottom).
Y=0.84
;@float|0.02|1|0.24|Gaussian radius in window-height units.
Radius=0.24
;@float|0|3|1.3|Relative influence in the weighted colour average.
Weight=1.3
;@float|0|0.3|0.05|How far the blob wanders (Lissajous drift).
Drift amp=0.05
;@float|0|2|0.09|Drift speed in radians per second.
Drift speed=0.09
;@color|0|0|#208A98|Blob colour.
Color=#208A98

[Blob 4]
;@bool|0|1|1|Include this gaussian colour source.
Enabled=1
;@float|-0.5|1.5|0.45|Horizontal centre (0 = left, 1 = right).
X=0.45
;@float|-0.5|1.5|0.97|Vertical centre (0 = top, 1 = bottom).
Y=0.97
;@float|0.02|1|0.22|Gaussian radius in window-height units.
Radius=0.22
;@float|0|3|0.8|Relative influence in the weighted colour average.
Weight=0.8
;@float|0|0.3|0.06|How far the blob wanders (Lissajous drift).
Drift amp=0.06
;@float|0|2|0.13|Drift speed in radians per second.
Drift speed=0.13
;@color|0|0|#185C84|Blob colour.
Color=#185C84

[Blob 5]
;@bool|0|1|1|Include this gaussian colour source.
Enabled=1
;@float|-0.5|1.5|0.36|Horizontal centre (0 = left, 1 = right).
X=0.36
;@float|-0.5|1.5|0.3|Vertical centre (0 = top, 1 = bottom).
Y=0.3
;@float|0.02|1|0.12|Gaussian radius in window-height units.
Radius=0.12
;@float|0|3|0.8|Relative influence in the weighted colour average.
Weight=0.8
;@float|0|0.3|0.07|How far the blob wanders (Lissajous drift).
Drift amp=0.07
;@float|0|2|0.21|Drift speed in radians per second.
Drift speed=0.21
;@color|0|0|#2A70B0|Blob colour.
Color=#2A70B0

[Blob 6]
;@bool|0|1|1|Include this gaussian colour source.
Enabled=1
;@float|-0.5|1.5|0.26|Horizontal centre (0 = left, 1 = right).
X=0.26
;@float|-0.5|1.5|0.1|Vertical centre (0 = top, 1 = bottom).
Y=0.1
;@float|0.02|1|0.1|Gaussian radius in window-height units.
Radius=0.1
;@float|0|3|0.7|Relative influence in the weighted colour average.
Weight=0.7
;@float|0|0.3|0.05|How far the blob wanders (Lissajous drift).
Drift amp=0.05
;@float|0|2|0.19|Drift speed in radians per second.
Drift speed=0.19
;@color|0|0|#8C3A60|Blob colour.
Color=#8C3A60

[Blob 7]
;@bool|0|1|1|Include this gaussian colour source.
Enabled=1
;@float|-0.5|1.5|0.86|Horizontal centre (0 = left, 1 = right).
X=0.86
;@float|-0.5|1.5|0.62|Vertical centre (0 = top, 1 = bottom).
Y=0.62
;@float|0.02|1|0.38|Gaussian radius in window-height units.
Radius=0.38
;@float|0|3|1|Relative influence in the weighted colour average.
Weight=1
;@float|0|0.3|0.03|How far the blob wanders (Lissajous drift).
Drift amp=0.03
;@float|0|2|0.07|Drift speed in radians per second.
Drift speed=0.07
;@color|0|0|#10306E|Blob colour.
Color=#10306E

[Blob 8]
;@bool|0|1|1|Include this gaussian colour source.
Enabled=1
;@float|-0.5|1.5|0.3|Horizontal centre (0 = left, 1 = right).
X=0.3
;@float|-0.5|1.5|0.54|Vertical centre (0 = top, 1 = bottom).
Y=0.54
;@float|0.02|1|0.1|Gaussian radius in window-height units.
Radius=0.1
;@float|0|3|0.6|Relative influence in the weighted colour average.
Weight=0.6
;@float|0|0.3|0.08|How far the blob wanders (Lissajous drift).
Drift amp=0.08
;@float|0|2|0.23|Drift speed in radians per second.
Drift speed=0.23
;@color|0|0|#805C68|Blob colour.
Color=#805C68

[Boundary]
;@bool|0|1|1|Diagonal edge that pushes the right side towards dark navy.
Enabled=1
;@float|-0.5|1.5|0.4|Boundary position at the top edge.
Top X=0.4
;@float|-0.5|1.5|0.68|Boundary position at the bottom edge.
Bottom X=0.68
;@float|0.001|0.3|0.035|Width of the transition across the boundary.
Softness=0.035
;@float|0|1|0.8|How strongly the right side is replaced by the boundary colour.
Strength=0.8
;@float|0|0.2|0.025|Sideways waviness of the boundary.
Wave amp=0.025
;@float|0|5|1.3|Number of waves from top to bottom.
Wave freq=1.3
;@float|0|3|0.25|Wave animation speed (rad/s).
Wave speed=0.25
;@color|0|0|#0A1E4B|Colour of the right side.
Color=#0A1E4B

[Corner shadow]
;@bool|0|1|1|Darkens a corner (top-right in the reference image).
Enabled=1
;@float|-0.5|1.5|1|Shadow centre X.
X=1
;@float|-0.5|1.5|-0.02|Shadow centre Y.
Y=-0.02
;@float|0.05|1.5|0.6|Shadow radius in window-height units.
Radius=0.6
;@float|0|1|0.85|Maximum darkening at the centre.
Strength=0.85

[Dot variation]
;@float|0|1|0.32|Random per-dot brightness variation.
Brightness jitter=0.32
;@float|0|1|0.2|Random per-dot mix towards a palette colour.
Hue jitter=0.2
;@float|0|3|0.15|How fast the per-dot brightness shimmers (Hz).
Jitter speed=0.15

[Sparkles]
;@bool|0|1|1|Random dots that bloom into vivid palette colours.
Enabled=1
;@float|0|0.5|0.03|Fraction of dots that can sparkle.
Probability=0.03
;@float|0|3|0.25|Sparkle cycle frequency (Hz).
Speed=0.25
;@float|0|1|0.9|Maximum colour takeover of a sparkling dot.
Intensity=0.9

[Flow trail]
;@bool|0|1|1|Stream of colourful dots flowing down along the boundary.
Enabled=1
;@float|-0.3|0.3|0|Horizontal offset of the trail from the boundary.
Offset=0
;@float|0.1|6|1.2|Trail half-width in cells.
Width=1.2
;@float|-6|6|1.2|Flow speed in cells per second (negative = upwards).
Speed=1.2
;@float|0|1|0.85|Colour takeover inside the trail.
Intensity=0.85
;@float|0|1|0.7|Fraction of trail segments that carry colour.
Density=0.7

[Highlights]
;@bool|0|1|1|Dots whose ring flares to a white-hot outline.
Enabled=1
;@float|0|0.2|0.018|Fraction of dots that can flare (x5 near the trail).
Probability=0.018
;@float|0|2|0.18|Flare cycle frequency (Hz).
Speed=0.18
;@float|1|4|1.8|Ring brightness multiplier at the peak.
Boost=1.8
;@color|0|0|#FFECE1|Ring colour at the peak of a flare.
Color=#FFECE1

[Breathing]
;@float|0|0.5|0.08|Global ring brightness pulsation.
Amplitude=0.08
;@float|0|2|0.25|Pulsation frequency (Hz).
Speed=0.25

[Haze layer]
;@bool|0|1|1|Bilinear blur of dot colours under everything (bokeh haze).
Enabled=1
;@float|0|1|0.14|Haze brightness.
Intensity=0.14

[Fill layer]
;@bool|0|1|1|Translucent disc inside each circle.
Enabled=1
;@float|0|1|0.75|Disc brightness.
Opacity=0.75
;@float|-1|1|0.15|Positive = darker centre / glassy rim, negative = domed.
Lens=0.15

[Center mark]
;@bool|0|1|1|Small dark cross cut out of every disc centre.
Enabled=1
;@float|0|0.5|0.14|Cross size as a fraction of the cell.
Size=0.14
;@float|0|1|0.75|How much fill the cross removes.
Darkness=0.75

[Ring layer]
;@bool|0|1|1|Neon outline of each circle (forms the diamond edges).
Enabled=1
;@float|0.005|0.15|0.035|Line width as a fraction of the cell.
Width=0.035
;@float|0|4|0.8|Ring brightness.
Intensity=0.8
;@float|0|3|1.6|Saturation boost of the ring colour vs. the fill.
Saturation=1.6
;@float|0|1|0|Amount of white added to every ring.
White mix=0

[Glow layer]
;@bool|0|1|1|Blurred halo around the ring (BGRABitmap radial blur).
Enabled=1
;@float|0.01|0.3|0.07|Blur radius as a fraction of the cell.
Radius=0.07
;@float|0|4|0.45|Halo brightness.
Intensity=0.45

[Contact sparks]
;@bool|0|1|1|Tiny coloured sparks where neighbouring circles touch.
Enabled=1
;@float|0.01|0.2|0.035|Spark radius as a fraction of the cell.
Size=0.035
;@float|0|4|1|Spark brightness.
Intensity=1
;@color|0|0|#FF2832|Spark colour.
Color=#FF2832

[Vignette]
;@bool|0|1|1|Darkens towards the window edges.
Enabled=1
;@float|0|1|0.5|Darkening at the outer radius.
Strength=0.5
;@float|0|1.5|0.5|Normalised radius where darkening starts.
Inner=0.5
;@float|0.2|2|1.35|Normalised radius of full darkening.
Outer=1.35

[Motion]
;@int|0|7|0|How the background colours move: 0 still, 1 pan (drifts on), 2 sway (back and forth), 3 orbit (circles), 4 rotate, 5 zoom pulse, 6 wave, 7 swirl. The dots stay on the board grid.
Mode=0
;@float|0|5|0.4|Speed of the motion (pan: field widths per 20 s, others: radians per second).
Speed=0.4
;@float|0|2|0.5|Size of the motion (sway, orbit, zoom, wave, swirl).
Amount=0.5
;@float|0|360|30|Direction in degrees for pan and sway (0 = right, 90 = down).
Direction=30
;@float|0.1|6|1.5|Waves across the screen (wave); size of the swirl (swirl).
Frequency=1.5
;@float|-0.5|1.5|0.5|Centre of rotate, zoom and swirl (0 = left, 1 = right).
Centre X=0.5
;@float|-0.5|1.5|0.5|Centre of rotate, zoom and swirl (0 = top, 1 = bottom).
Centre Y=0.5

[Colour show]
;@int|0|7|0|A clearly visible moving pattern over the background colours: 0 off, 1 audio equalizer bars, 2 spinning colour wheel, 3 cartoon runners, 4 ripples, 5 spinning spiral, 6 plasma waves, 7 rain.
Mode=3
;@float|0|1|0.85|How strongly the pattern covers the background colours.
Strength=1
;@float|0|5|1|Speed of the pattern.
Speed=1.2
;@float|0.2|3|1|Size of the pattern (bar height, wheel twist, cartoon size, ripple spacing...).
Size=1.4
;@int|0|1|0|0 = the palette colours, 1 = rainbow colours.
Rainbow=0
;@int|1|40|12|Number of equalizer bars, colour wheel sectors or spiral arms.
Bars / arms=12
;@float|-0.5|1.5|0.5|Centre of the wheel, ripples and spiral (0 = left, 1 = right).
Centre X=0.5
;@float|-0.5|1.5|0.5|Centre / height of the wheel, ripples, spiral and cartoon (0 = top, 1 = bottom).
Centre Y=0.5

[Dot motion]
;@int|0|6|0|The background dots move: 0 still, 1 shake (explosion bursts), 2 squeezed back and forth, 3 pushed / pulled by a moving point, 4 blast waves, 5 swirling orbits, 6 breathing.
Mode=0
;@float|0|2|0.35|How far the dots move, in cells.
Amount=0.35
;@float|0|5|1|Speed of the motion.
Speed=1
;@float|0.1|5|1|Shake speed, wave length, size of the push area, blast spacing.
Frequency=1
;@int|0|2|0|Mode 3: 0 the point pushes the dots away, 1 it pulls them in, 2 both in turn.
Push / pull=0
;@float|-0.5|1.5|0.5|Centre of the push point, blasts and breathing (0 = left, 1 = right).
Centre X=0.5
;@float|-0.5|1.5|0.5|Centre of the push point, blasts and breathing (0 = top, 1 = bottom).
Centre Y=0.5
;@bool|0|1|0|Also move the game beads (off keeps the board readable).
Beads too=0

[Dot shape]
;@int|0|7|0|Shape of every dot: 0 circle, 1 square, 2 diamond, 3 triangle, 4 hexagon, 5 star, 6 flower, 7 heart.
Shape=0
;@float|-180|180|0|Fixed rotation of the shapes in degrees.
Angle=0
;@float|-720|720|0|Spinning speed in degrees per second (0 = no spin).
Spin=0
;@float|0|1|0|Different spin per dot: neighbours turn the other way, speeds vary.
Variation=0
;@bool|0|1|1|Also turn the game beads.
Beads too=1

[Palette]
;@color|0|0|#E41A2A|Accent colour used by jitter, sparkles and the trail.
Color 1=#E41A2A
;@color|0|0|#CC267C|Accent colour used by jitter, sparkles and the trail.
Color 2=#CC267C
;@color|0|0|#2CD4E8|Accent colour used by jitter, sparkles and the trail.
Color 3=#2CD4E8
;@color|0|0|#E88C28|Accent colour used by jitter, sparkles and the trail.
Color 4=#E88C28
;@color|0|0|#7C34A8|Accent colour used by jitter, sparkles and the trail.
Color 5=#7C34A8
;@color|0|0|#D67A98|Accent colour used by jitter, sparkles and the trail.
Color 6=#D67A98
