; Neon game sound effects - edit with NeonSfxEditor (NeonGrid SDL3 GPU Tools) or by hand.
; [name] Layers=n, then [name.1] .. [name.n]: Shape (sine soft bell square saw triangle
; noise), F0/F1 Hz, Dur/Attack/Delay s, Decay, Gain, Pan, Noise/NoiseDur, Count/Every,
; Steps/StepsEnd (semitones per repeat), PanSpread, PanAlt, Param* (game parameter).

; Beads: a group pops (param = group size) / Trail: a sparkle is eaten (param = combo)
[pop]
Layers=2
[pop.1]
Shape=bell
F0=528
F1=330
Dur=0.24
Attack=0.004
Decay=5
Delay=0
Gain=0.45
Pan=0
Noise=0.35
NoiseDur=0.009
Count=1
Every=0
Steps=
StepsEnd=
PanSpread=0
PanAlt=0
ParamBase=2
ParamSemis=2
ParamSemisMax=24
ParamDur=0.01
ParamDurMax=0.23
ParamCountDiv=0
ParamCountMax=0
[pop.2]
Shape=bell
F0=660
F1=693
Dur=0.18
Attack=0.002
Decay=5
Delay=0
Gain=0.12
Pan=0
Noise=0
NoiseDur=0
Count=0
Every=0
Steps=3 5 7 10 12
StepsEnd=0 0 0 0 0
PanSpread=0
PanAlt=1
ParamBase=2
ParamSemis=2
ParamSemisMax=24
ParamDur=0
ParamDurMax=0
ParamCountDiv=4
ParamCountMax=5

